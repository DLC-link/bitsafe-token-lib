# bitsafe-token examples. Copy to .env and fill in your values.
#
# dotenvy does not override a variable your shell already exported. Run the
# build and test gates in a shell that has not sourced this file.

# The network: devnet, testnet or mainnet. Every per-network value follows it.
ENVIRONMENT=devnet

# The asset the Token Standard examples work on: cbtc. Phase 2 adds beth.
# The bridge examples under examples/<asset>/ ignore it.
ASSET=cbtc

# Your participant's JSON ledger API, including the API path, and your party.
LEDGER_HOST=https://participant.example.com/api/json-api
PARTY_ID=your-party::1220abcdef...

# Keycloak. Host only; do not append /auth.
KEYCLOAK_HOST=https://keycloak.example.com
KEYCLOAK_REALM=your-realm
KEYCLOAK_CLIENT_ID=your-client-id
KEYCLOAK_USERNAME=your-username
KEYCLOAK_PASSWORD=your-password

# Overrides for a custom network. Leave unset for the three named networks.
# An empty value counts as unset.
# REGISTRAR_PARTY=
# REGISTRY_URL=
# The bridge examples under examples/<asset>/ ignore these overrides.

# Mint and redeem.
DESTINATION_BTC_ADDRESS=
WITHDRAW_AMOUNT=0.001

# Transfers.
TRANSFER_AMOUNT=0.1
TRANSFER_COUNT=10
RECEIVER_PARTY_ID=receiver-party::1220...
RECIPIENTS_CSV=recipients.csv
SPLIT_AMOUNTS=0.001
CONSOLIDATION_THRESHOLD=10

# Allocations. Set ALLOCATION_CONTRACT_ID per run, on the command line.
ALLOCATE_AMOUNT=0.1
EXECUTOR_PARTY_ID=executor-party::1220...
SETTLEMENT_REF_ID=cbtc-dvp-example
# ALLOCATION_CONTRACT_ID=

# The receiver's own login, for reject_transfer. The three optional values
# fall back to the sender's.
RECEIVER_KEYCLOAK_CLIENT_ID=
RECEIVER_KEYCLOAK_USERNAME=
RECEIVER_KEYCLOAK_PASSWORD=
# RECEIVER_LEDGER_HOST=
# RECEIVER_KEYCLOAK_HOST=
# RECEIVER_KEYCLOAK_REALM=

RUST_LOG=info,tungstenite=error,tokio_tungstenite=error,reqwest=error
